.venv/
__pycache__/
*.pyc
.pytest_cache/
results/
*.egg-info/
# real rack inventories carry hostnames; keep them local
inventory/*.local.yaml
# dated inventory backups written by the UI's inventory editor
inventory/*.bak-*
.DS_Store
# vendor tools copied from the lab (binaries, builds, AMD-internal sources) - never commit
tools/RcclSmokeTest-*/
tools/TransferBench/
tools/rccl-tests/
tools/*.rtf
# Office lock files (workbook open in Excel)
~$*

# workbook backups written by tools/update_testplan.py
testplan/*.backup-*.xlsx
testplan/~$*

# installer bundles (tools/build_ui_installer.py)
dist/

# SLM training data (tools/vrack_dataset.py, tools/dataset_export.py): generated, may hold rack addresses
dataset/
